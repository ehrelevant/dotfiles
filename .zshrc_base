# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e

# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/ehren/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

# =====================================================
# Miscellaneous Configuration
# =====================================================
# Configure key mappings
source ~/.zshrc_mappings

# Configure aliases
source ~/.zshrc_aliases

# Configure fzf to use catpuccin colorscheme
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#313244,label:#CDD6F4"

# Run starship (a shell prompt) on shell init
eval "$(starship init zsh)"

# =====================================================
# Plugin Configuration
# =====================================================
# Enable fzf-tab
# Requires fzf to be installed
# Should be before zsh-autosuggestions and zsh-patina
autoload -U compinit; compinit
source ~/.zsh/fzf-tab/fzf-tab.plugin.zsh

# Enable zsh-history-substring-search
source ~/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh

# Enable zsh-autosuggestions
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# Enable zsh-histdb
# Requires sqlite3 package to be installed via OS package manager
source ~/.zsh/zsh-histdb/sqlite-history.zsh

# Enable zsh-patina (syntax-highlighting)
# The zsh-patina package must be installed via cargo
eval "$(~/.cargo/bin/zsh-patina activate)"

# Enables zoxide
# Must be after compinit
# The zoxide package must be installed via cargo
eval "$(zoxide init zsh)"
