{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "provider": {
    "llama-cpp": {
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "not-needed",
        "toolParser": [ { "type": "raw-function-call" }, { "type": "json" } ]
      },
      "models": {
	      "gemma-4": {
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen-3.6": {
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          }
        }
      }
    }
  }
}
